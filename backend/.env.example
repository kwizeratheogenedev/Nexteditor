# Auto captions use local whisper.cpp. No API key is required.
# Run: powershell -ExecutionPolicy Bypass -File scripts/setup-whisper.ps1
WHISPER_MODEL_PATH=./whisper/models/ggml-base.bin
WHISPER_THREADS=4
WHISPER_TIMEOUT=3600000

# Faster values render sooner; slower values can produce smaller output files.
CAPTION_ENCODE_PRESET=veryfast
CAPTION_CRF=20

# YouTube upload (Montage tab "Upload to YouTube" button). Create these in
# the Google Cloud Console - see the setup instructions from Claude for the
# exact steps. YOUTUBE_REDIRECT_URI must exactly match the "Authorized
# redirect URI" configured on the OAuth client.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/auth/callback

# --- Dat   abase (MongoDB Atlas) ---
MONGO_URI=

# --- Auth ---
# Any long random string - used to sign session JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Only needed if the frontend and backend end up on different subdomains in production.
COOKIE_DOMAIN=
# Where the frontend is served from - used for OAuth/payment redirects.
FRONTEND_URL=http://localhost:5173

# --- Google Sign-In (app login - separate OAuth client from YOUTUBE_CLIENT_ID/SECRET
# above, since login only needs identity scopes, not YouTube upload access) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- MTN Mobile Money (MoMo Open API - Collections/Request-to-Pay) ---
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=

# --- Card payments (provider TBD) ---
CARD_PROVIDER_SECRET_KEY=
CARD_PROVIDER_WEBHOOK_SECRET=
