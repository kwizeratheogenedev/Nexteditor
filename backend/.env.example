# --- Server ---
# PORT is normally set by the hosting platform (Render/Fly/etc.) - only set
# it yourself for local overrides. Falls back to 3000 (with auto-retry on
# the next few ports) when unset.
PORT=3000
# Must be "production" on any real deployment - non-production allows any
# CORS origin, which is only safe for local dev.
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (your deployed
# frontend's URL). Ignored while NODE_ENV isn't "production".
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# This server's own public URL - used for internal callbacks (e.g. shorts/
# reformat routes fetching a file back from itself).
BACKEND_URL=http://localhost:3000

# --- Database (MongoDB Atlas) ---
MONGO_URI=

# --- Auth ---
# Any long random string - used to sign session JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Only needed if the frontend and backend end up on different subdomains in production.
COOKIE_DOMAIN=
# Where the frontend is served from - used for OAuth/payment redirects.
FRONTEND_URL=http://localhost:5173
# Comma-separated emails granted owner/admin access.
OWNER_EMAILS=

# --- Encoding ---
# Faster values render sooner; slower values can produce smaller output files.
FFMPEG_TIMEOUT=3600000
CAPTION_ENCODE_PRESET=veryfast
CAPTION_CRF=20
EXPORT_ENCODE_PRESET=veryfast
EXPORT_CRF=20
# LongMix Studio renders its background in parallel ffmpeg processes. The default
# is a quarter of your CPU cores (1 to 3); raise it only on a big machine.
# LONGMIX_CONCURRENCY=3
# How long finished renders stay downloadable (default 24).
# CLIPS_RETENTION_HOURS=24
SHORTS_ENCODE_PRESET=veryfast
SHORTS_CRF=20

# --- Auto captions (Groq's hosted Whisper API) ---
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_TIMEOUT=

# --- YouTube upload (Montage tab "Upload to YouTube" button). Create these in
# the Google Cloud Console - see the setup instructions from Claude for the
# exact steps. YOUTUBE_REDIRECT_URI must exactly match the "Authorized
# redirect URI" configured on the OAuth client. ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/auth/callback

# --- Google Sign-In (app login - separate OAuth client from YOUTUBE_CLIENT_ID/SECRET
# above, since login only needs identity scopes, not YouTube upload access) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- MTN Mobile Money (MoMo Open API - Collections/Request-to-Pay) ---
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_CURRENCY=EUR
MOMO_PRO_PRICE=5
MOMO_CALLBACK_URL=

# --- Card payments (Flutterwave) ---
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_CURRENCY=
FLW_PRO_PRICE=

# Optional: folder for uploads/ and clips/ (e.g. a mounted persistent disk).
# Unset = backend/uploads and backend/clips; on Vercel the temp dir is used.
# STORAGE_DIR=/data/nexeditor
